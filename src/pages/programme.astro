---
import Base from "../layouts/Base.astro";
import { SESSIONS, EVENTS, PLACE, TIME } from "../data/site.js";
const dateOf = (n) => EVENTS.find((e) => e.session === n);
const fmt = (e) => e ? new Date(e.date + "T12:00:00").toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" }) + `, ${TIME}, ${PLACE}` : "";
---
<Base title="Programme">
  <header class="pagehead wrap">
    <div class="kicker">The programme</div>
    <h1>What we do in our sessions</h1>
    <p class="lede muted">Each session is 30 minutes, on a Wednesday from 9 to 9:30 pm in the LC Foyer. We read something short together at the start, so you don't need to prepare anything. Session 1 is this term, sessions 2 to 5 are in Term 2, and session 6 is in Term 3.</p>
  </header>

  <section class="wrap" style="padding-bottom:70px">
    <div class="stabs" role="tablist" aria-label="Sessions">
      {SESSIONS.map((s, i) => <button role="tab" id={`tab-${s.n}`} aria-controls={`s-${s.n}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>Session {s.n}</button>)}
    </div>
    {SESSIONS.map((s, i) => (
      <div class="spanel" role="tabpanel" id={`s-${s.n}`} aria-labelledby={`tab-${s.n}`} hidden={i !== 0}>
        <img class="sphoto" src={s.img} alt={s.alt} width="1600" height="900" loading={i === 0 ? "eager" : "lazy"} />
        <div class="two">
        <div>
          <h2>{s.title}</h2>
          <div class="date">{fmt(dateOf(s.n))}</div>
          <p>{s.idea}</p>
          <h3>The African side of it</h3>
          <p>{s.africa}</p>
        </div>
        <div>
          <h3 style="margin-top:6px">What we read</h3>
          <ul>{s.read.map((r) => <li><a href={r.url}>{r.title}</a>, {r.by}</li>)}</ul>
          <h3>What we discuss</h3>
          <ul>{s.questions.map((q) => <li>{q}</li>)}</ul>
        </div>
        </div>
      </div>
    ))}
  </section>
</Base>
<script>
  const tabs = [...document.querySelectorAll('[role="tab"]')];
  function pick(t) {
    tabs.forEach((x) => { const on = x === t; x.setAttribute("aria-selected", String(on)); x.tabIndex = on ? 0 : -1; document.getElementById(x.getAttribute("aria-controls")).hidden = !on; });
    history.replaceState(null, "", "#" + t.getAttribute("aria-controls"));
  }
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => pick(t));
    t.addEventListener("keydown", (e) => { const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0; if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); pick(n); } });
  });
  const start = tabs.find((t) => "#" + t.getAttribute("aria-controls") === location.hash);
  if (start) pick(start);
</script>
