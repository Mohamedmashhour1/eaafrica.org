---
import Base from "../layouts/Base.astro";
import { OPPORTUNITIES } from "../data/site.js";
---
<Base title="Opportunities">
  <header class="pagehead wrap">
    <h1>Opportunities worth checking out</h1>
    <p class="lede muted">Free guides, courses and communities that are genuinely useful, now and later on. If you want help with any of them, just ask Ali or Yassir.</p>
  </header>
  <section class="wrap" style="padding-bottom:80px">
    {OPPORTUNITIES.map((g) => (
      <div class="ogroup">
        <h2>{g.group}</h2>
        {g.items.map((o) => <div class="opp"><h3 class="org"><img class="orglogo" src={o.logo} alt="" width="30" height="30" /><a href={o.url}>{o.name}</a></h3><p>{o.text}</p></div>)}
      </div>
    ))}
  </section>
</Base>
