---
import Base from "../layouts/Base.astro";
import { FORM_URL, PLACE } from "../data/site.js";
const embed = FORM_URL ? FORM_URL.replace(/\/viewform.*$/, "/viewform?embedded=true") : "";
---
<Base title="Join">
  <header class="pagehead wrap">
    <h1>Join the club</h1>
    <p class="lede muted">Signing up takes two minutes, and it means you will hear about every meeting. We meet on Wednesdays from 9 to 9:30 pm in the {PLACE}.</p>
  </header>
  <figure class="strip wrap"><img src="/media/photos/join.jpg" alt="Students in a classroom" width="1600" height="900" /></figure>
  <section class="wrap" style="padding-bottom:80px">
    {embed
      ? <div class="formbox"><iframe src={embed} title="Sign up for Effective Altruism at ALA" loading="lazy">Loading the form</iframe></div>
      : <p>For now, just find Ali Mohamed or Yassir Ben Ahijba on campus and they will add you, or come to the next meeting.</p>}
  </section>
</Base>
